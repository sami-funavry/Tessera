# ─── Tessera .env.example ─────────────────────────────────────────────────────
# Copy to .env and fill in the values. Never commit .env to version control.
# All values are required unless marked (optional).

# ─── RPC Endpoints ────────────────────────────────────────────────────────────

# Sepolia (EVM) JSON-RPC URL — Infura, Alchemy, or self-hosted
ETHERUM_SEPOLIA_ENDPOINT=https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>

# Neutron (CosmWasm) Tendermint RPC
NEUTRON_RPC_URL=https://rpc-palvus.pion-1.ntrn.tech

# Neutron gRPC endpoint (used for some Cosmos queries)
NEUTRON_GRPC_URL=grpc-palvus.pion-1.ntrn.tech:443

# Neutron REST / LCD endpoint
NEUTRON_REST_URL=https://rest-palvus.pion-1.ntrn.tech

# Neutron chain ID
NEUTRON_CHAIN_ID=pion-1

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Supabase project URL (e.g. https://xyzxyz.supabase.co)
SUPABASE_PROJECT_URL=https://<YOUR_PROJECT_REF>.supabase.co

# Supabase service-role key (grants write access; keep this secret)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SERVICE_ROLE_KEY>

# Supabase anon key (frontend read-only access; safe to expose)
SUPABASE_ANON_KEY=<YOUR_ANON_KEY>

# ─── Etherscan ────────────────────────────────────────────────────────────────

# Used by Foundry scripts for contract verification after deployment
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>
ETHERSCAN_API_URL=https://api-sepolia.etherscan.io/api

# ─── Deployer Keys (P-5 deployment only — NOT relayer keys) ───────────────────

# Hex-encoded secp256k1 private key for deploying Solidity contracts on Sepolia
# Generate with: cast wallet new
SEPOLIA_DEPLOYER_PRIVATE_KEY=<64 hex chars, no 0x prefix>

# Hex-encoded secp256k1 private key for deploying CosmWasm contracts on Neutron
NEUTRON_DEPLOYER_PRIVATE_KEY=<64 hex chars, no 0x prefix>

# ─── Relayer Keys (used at runtime) ───────────────────────────────────────────

# Active relayer's private key (set to A or B key when starting each instance)
# Same key is used for both Sepolia (ECDSA) and Neutron (secp256k1) signing.
RELAYER_PRIVATE_KEY=<64 hex chars, no 0x prefix>

# Relayer A private key (used by scripts/register-relayers.sh)
RELAYER_A_PRIVATE_KEY=<64 hex chars, no 0x prefix>

# Relayer B private key (used by scripts/register-relayers.sh)
RELAYER_B_PRIVATE_KEY=<64 hex chars, no 0x prefix>

# ─── Deployed Contract Addresses (populated after P-5 deployment) ─────────────

# Sepolia
SEPOLIA_TUSDC=0x<address>
SEPOLIA_BOND=0x<address>
SEPOLIA_REGISTRY=0x<address>
SEPOLIA_VERIFIER=0x<address>
SEPOLIA_VAULT=0x<address>
SEPOLIA_MINT=0x<address>

# Neutron pion-1
NEUTRON_TUSDC=neutron1<bech32>
NEUTRON_BOND=neutron1<bech32>
NEUTRON_REGISTRY=neutron1<bech32>
NEUTRON_VERIFIER=neutron1<bech32>
NEUTRON_VAULT=neutron1<bech32>
NEUTRON_MINT=neutron1<bech32>

# ─── Frontend (Next.js public env vars) ───────────────────────────────────────
# Prefix with NEXT_PUBLIC_ so they are inlined at build time.

NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_ANON_KEY>
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>
NEXT_PUBLIC_NEUTRON_REST_URL=https://rest-palvus.pion-1.ntrn.tech
NEXT_PUBLIC_NEUTRON_CHAIN_ID=pion-1
